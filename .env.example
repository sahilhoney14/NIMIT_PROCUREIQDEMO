# ==============================================================================
# ProcureIQ Unified Server - Environment Variables Template
# Copy this file to backend/.env
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL 8.x)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=ProcureIQ
DB2_NAME=ProcureIQ_Logs

# Security & Authentication Secrets
SESSION_SECRET=change_this_to_a_secure_random_string_in_production
JWT_SECRET=change_this_to_a_secure_jwt_secret_in_production
JWT_EXPIRES_IN=6d
JWT_ACCESS_EXPIRES_IN=6d
JWT_REFRESH_EXPIRES_IN=6d
SESSION_MAX_AGE=518400000

# Dashboard Routing Paths (2 Portals)
ADMIN_URL=/admin
PROCUREMENT_URL=/procurement

# Company Tax Details
GST_NUMBER=24AMHPS5080K1ZO
